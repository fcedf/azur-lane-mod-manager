{
  "name": "fms-desktop",
  "version": "1.1.2",
  "private": true,
  "description": "文件管理系统桌面版",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:electron": "electron .",
    "build:web": "npm --prefix web run build",
    "dist": "npm run build:web && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.yourname.fms",
    "productName": "文件管理系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "server/src",
        "to": "server/src"
      },
      {
        "from": "server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "web/dist",
        "to": "web/dist"
      },
      {
        "from": "runtime/node.exe",
        "to": "runtime/node.exe"
      },
      {
        "from": "runtime/python",
        "to": "runtime/python"
      },
      {
        "from": "server/scripts",
        "to": "server/scripts"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "文件管理系统",
      "artifactName": "AzurLaneModManager-Setup-${version}.${ext}"
    }
  }
}
